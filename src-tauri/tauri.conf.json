{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DNS Profile Creator",
  "version": "../deno.json",
  "identifier": "local.encrypted-dns.tool",
  "build": {
    "beforeDevCommand": "deno task build",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DNS Profile Creator",
        "width": 900,
        "height": 840,
        "minWidth": 720,
        "visible": false,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 28 },
        "acceptFirstMouse": true,
        "allowLinkPreview": false
      },
      {
        "label": "settings",
        "create": false,
        "url": "settings.html",
        "title": "Settings",
        "width": 520,
        "height": 440,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 28 },
        "acceptFirstMouse": true,
        "allowLinkPreview": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "copyright": "Copyright © 2026 Marcel (tofulupo). BSD 3-Clause License.",
    "category": "public.app-category.utilities",
    "fileAssociations": [
      {
        "ext": ["mobileconfig"],
        "contentTypes": ["com.apple.mobileconfig"],
        "name": "Configuration Profile",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "../desktop/AppIcon.icon",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
