{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DNS Profile Creator",
  "version": "../deno.json",
  "identifier": "local.encrypted-dns.tool",
  "build": {
    "beforeDevCommand": "deno task build",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DNS Profile Creator",
        "width": 900,
        "height": 840,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "copyright": "Copyright © 2026 Marcel (tofulupo). BSD 3-Clause License.",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "../desktop/AppIcon.icon",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
