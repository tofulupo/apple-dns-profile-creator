{
  "version": "4.0.0-rc.3",
  "license": "BSD-3-Clause",
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-run --allow-net --allow-env scripts/serve.ts --watch",
    "build": "deno run --env-file=.env --allow-read --allow-write --allow-run --allow-env=TAURI_ENV_PLATFORM,WEB_FONTS_DIR scripts/build.ts",
    "build:deno-deploy": "deno run --allow-read --allow-write --allow-run --allow-env=INDEXNOW_KEY,TAURI_ENV_PLATFORM,R2_ENDPOINT,R2_ACCOUNT_ID,R2_BUCKET,R2_ACCESS_KEY_ID,R2_SECRET_ACCESS_KEY --allow-net=*.r2.cloudflarestorage.com scripts/build.ts --deno-deploy",
    "fonts": "deno run --allow-read --allow-write --allow-run scripts/fonts.ts",
    "preview": "deno run --allow-read --allow-write --allow-run --allow-net --allow-env scripts/serve.ts",
    "desktop": "deno task tauri build",
    "desktop:dev": "deno task tauri dev",
    "desktop:release": "deno run --env-file=.env.release --allow-read --allow-write --allow-run --allow-env scripts/desktop_release.ts",
    "desktop:icon": "deno run --allow-read --allow-write --allow-run scripts/app_icon.ts",
    "tauri": "deno run -A @tauri-apps/cli",
    "test": "deno task test:web && deno task test:desktop",
    "test:web": "deno test --allow-read --allow-write --allow-run --allow-net=127.0.0.1",
    "test:desktop": "deno task build && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "deno task tauri build --debug --no-bundle && deno test --allow-read --allow-write --allow-run=tauri-driver,pgrep,xdotool,src-tauri/target/debug/dns-profile-creator --allow-env --allow-net=127.0.0.1 test/e2e/*.e2e.ts",
    "test:browser": "deno task build && deno test --allow-read --allow-write --allow-run --allow-env --allow-net --allow-sys=networkInterfaces,homedir,osRelease,uid test/browser/*.browser.ts",
    "lint:desktop": "deno task build && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "lint:md": "deno run -A npm:rumdl@^0.2 check .",
    "check": "deno check src pages 'test/**/*.test.ts' test/helpers scripts && deno check 'test/e2e/*.e2e.ts' 'test/browser/*.ts' && deno check --config src/lib/pure.deno.jsonc src/lib && deno lint && deno fmt --check && deno task lint:md && deno task lint:desktop && deno task test",
    "check:live": "deno run --allow-run=curl scripts/check_live.ts",
    "indexnow": "deno run --env-file=.env --allow-env=INDEXNOW_KEY --allow-net=mobileconfig.io,api.indexnow.org scripts/indexnow.ts",
    "fixtures:fetch": "deno run --allow-net --allow-read --allow-write --allow-run scripts/fetch_fixtures.ts",
    "fixtures:lint": "deno run --allow-read --allow-run scripts/lint_fixtures.ts",
    "deps:update": "deno run --allow-read --allow-write --allow-run=deno,cargo --allow-net=index.crates.io scripts/deps_update.ts"
  },
  "imports": {
    "@std/semver": "jsr:@std/semver@^1.0.8",
    "@tauri-apps/cli": "npm:@tauri-apps/cli@^2.12.3",
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/http": "jsr:@std/http@^1.1.4",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.21",
    "aws4fetch": "npm:aws4fetch@^1.0.20",
    "webdriverio": "npm:webdriverio@^10.0.2"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true
  },
  "deploy": {
    "build": "deno task build:deno-deploy",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "scripts/server.ts"
    }
  },

  "fmt": {
    "lineWidth": 80,
    "exclude": [
      "dist/",
      "test/fixtures/",
      "flags/",
      "desktop/AppIcon.icon/",
      "src-tauri/target/",
      "src-tauri/gen/"
    ]
  },
  "lint": {
    "exclude": ["dist/", "test/fixtures/"]
  },
  "exclude": [
    "dist/",
    "test/fixtures/",
    "src-tauri/target/",
    "src-tauri/gen/"
  ]
}
