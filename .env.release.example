# Settings for `deno task desktop:release`. Copy to .env.release, which git
# ignores, and fill in. Nothing here is committed with values.

# The Developer ID Application certificate to sign with, by its SHA-1
# fingerprint: `security find-identity -v -p codesigning` lists it. The
# fingerprint rather than the name, which codesign refuses as ambiguous when
# the certificate is in more than one keychain.
APPLE_SIGNING_IDENTITY=

# An App Store Connect API key, for notarization only: it publishes nothing.
# Create one at https://appstoreconnect.apple.com/access/integrations/api
# (Team Keys, access "Developer"). Keep the .p8 file outside this project;
# Apple offers the download once.
# Issuer ID, shown above the list of keys.
APPLE_API_ISSUER=
# Key ID, in the key's row.
APPLE_API_KEY=
# Absolute path of the downloaded AuthKey_<Key ID>.p8.
APPLE_API_KEY_PATH=
